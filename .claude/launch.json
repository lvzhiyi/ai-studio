{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "engine",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "engine", "run", "studio", "web", "--no-browser"],
      "port": 8780
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "server", "run", "start:dev"],
      "port": 3000
    }
  ]
}
