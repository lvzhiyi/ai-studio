# ai-studio 后端（server/）的本地配置：复制为 .env 后填写，.env 不进 git
PORT=3000

# 不填则使用模拟数据，本地开发和录演示视频不花钱
LLM_API_KEY=

# 任意 OpenAI 兼容的 Chat Completions 接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 通义千问示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 每个设备（没有设备 ID 时按 IP）每分钟最多生成几次
RATE_LIMIT_PER_MINUTE=10

# Web 版允许的来源，逗号分隔；留空表示允许任意来源（仅限开发）
CORS_ORIGINS=

# studio-engine 控制台。适配器只访问这个地址，不把 run / 用户传给引擎。
ENGINE_BASE_URL=http://127.0.0.1:8780
